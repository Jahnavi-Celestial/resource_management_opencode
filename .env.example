NODE_ENV=development
PORT=4000

DB_HOST=your_db_host
DB_PORT=your_db_port
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

JWT_SECRET=your_jwt_key
JWT_EXPIRY=your_jwt_expiry_time

# Leave SENDGRID_API_KEY empty for local dev: the noop provider is used and every
# outbox row is marked SENT without leaving the machine. Setting it switches to
# SendGrid. With NODE_ENV=production an empty key is a hard boot error.
SENDGRID_API_KEY=
EMAIL_FROM=email
# FR-61 outbox dispatcher cadence and retry ceiling.
EMAIL_DISPATCH_CRON=* * * * *
EMAIL_MAX_ATTEMPTS=5

WS_PORT=port

REJECTION_REASON_MIN_LENGTH=10
REMINDER_LEAD_TIME_MINUTES=60
# S10 cadence for the two booking-clock jobs (complete-elapsed-bookings,
# send-reminders). Both are idempotent and cheap when idle, so the interval is
# purely a freshness/latency choice — 5 minutes bounds how late a reminder can be
# against REMINDER_LEAD_TIME_MINUTES and how long a finished booking stays
# APPROVED. See docs/PLAN.md assumption #10.
BOOKING_JOBS_CRON=*/5 * * * *

ADMIN_EMAIL=admin@resource.local
ADMIN_PASSWORD=Admin@12345!